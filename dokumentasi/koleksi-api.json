{
  "info": {
    "name": "Sistem Inventaris Laboratorium Komputer API",
    "description": "Koleksi Postman untuk Endpoint Autentikasi, Users Management, Kategori, dan Barang",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autentikasi",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@uai.ac.id\",\n  \"password\": \"admin 12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Manajemen User (Khusus Admin)",
      "item": [
        {
          "name": "Get Semua User (Search, Filter Role, Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/users?cari=staff&role=operator&halaman=1&batas=10&urut=created_at&arah=desc",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "users"],
              "query": [
                { "key": "cari", "value": "staff" },
                { "key": "role", "value": "operator" },
                { "key": "halaman", "value": "1" },
                { "key": "batas", "value": "10" },
                { "key": "urut", "value": "created_at" },
                { "key": "arah", "value": "desc" }
