    {
      "name": "Barang",
      "item": [
        {
          "name": "Get Barang Terfilter & Paginasi",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/barang?cari=Dell&kondisi=Baik&halaman=1&batas=10&urut=jumlah&arah=desc",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "barang"],
              "query": [
                { "key": "cari", "value": "Dell" },
                { "key": "kondisi", "value": "Baik" },
                { "key": "halaman", "value": "1" },
                { "key": "batas", "value": "10" },
                { "key": "urut", "value": "jumlah" },
                { "key": "arah", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Tambah Barang (Multipart/form-data)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "kode_barang", "value": "INV-NEW-01", "type": "text" },
                { "key": "nama_barang", "value": "Barang Baru", "type": "text" },
                { "key": "kategori_id", "value": "1", "type": "text" },
                { "key": "kondisi", "value": "Baik", "type": "text" },
                { "key": "lokasi", "value": "Lab A", "type": "text" },
                { "key": "jumlah", "value": "5", "type": "text" },
                { "key": "foto", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "http://localhost:3000/api/barang",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "barang"]
            }
          }
        }
